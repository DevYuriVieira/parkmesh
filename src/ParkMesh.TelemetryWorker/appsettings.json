{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ParkMeshApi": {
    "BaseUrl": "http://localhost:5000"
  },
  "Mqtt": {
    "Enabled": true,
    "Host": "localhost",
    "Port": 1883,
    "ClientIdPrefix": "parkmesh-worker",
    "ReconnectDelaySeconds": 3
  },
  "SensorDebounce": {
    "MinConsecutiveReadings": 2,
    "StabilityWindowMs": 1500,
    "ChannelCapacity": 10000
  }
}
