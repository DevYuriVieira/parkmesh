{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": ""
  },
  "RedisLease": {
    "KeyPrefix": "parkmesh"
  },
  "Mqtt": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 1883,
    "ClientIdPrefix": "parkmesh-api"
  },
  "SensorDebounce": {
    "MinConsecutiveReadings": 2,
    "StabilityWindowMs": 1500,
    "ChannelCapacity": 10000
  }
}
